# Picovoice API Configuration
PICOVOICE_API_KEY=your_picovoice_api_key_here

# Platform Configuration
# Options: linux, raspberry-pi
# linux: uses built-in "Alexa" wake word
# raspberry-pi: uses custom "Hey Olaf" wake word file
PLATFORM=linux

# LLM API Configuration
# Groq (recommended - fast and free)
GROQ_API_KEY=your_groq_api_key_here

# Claude (alternative)
ANTHROPIC_API_KEY=your_api_key_here

# Audio Configuration (optional - will auto-detect if not set)
# MICROPHONE_DEVICE_INDEX=0
# SPEAKER_DEVICE_INDEX=0

# Whisper Model Configuration
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
